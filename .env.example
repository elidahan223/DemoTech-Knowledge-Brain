# Copy to .env at project root. See docs/INSTALL-WINDOWS.md for all defaults.
NODE_ENV=development
PORT=3210
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
RAG_EMBED_MODEL=embeddinggemma:latest
# Fresh developer repository; does not require any bundled demo documents.
BRAIN_DATA_DIR=./repositories/developer-local
BRAIN_REPOSITORY_NAME=Developer-Local
BRAIN_SEED_DEMO=0
BRAIN_AUTO_AI_ANALYSIS=1
BRAIN_PAUSE_BACKGROUND=0
BRAIN_TRACE_AI=0
# Optional overrides; leave commented unless needed.
# BRAIN_APP_ROOT=.
# BRAIN_STATIC_DIR=./dist
# BRAIN_DESKTOP_USER_DATA=./repositories/desktop-developer
# BRAIN_DESKTOP_LEGACY_DATA=./repositories/no-legacy
# BRAIN_DESKTOP and BRAIN_DESKTOP_TOKEN are generated internally by Electron.
