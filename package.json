{
  "name": "demotech-knowledge-brain",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.{ts,mjs}\" \"shared/**/*.ts\" \"tests/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.{ts,mjs}\" \"shared/**/*.ts\" \"tests/**/*.{ts,mjs}\"",
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx server/seed.ts",
    "reindex": "tsx scripts/reindex.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs && node scripts/create-desktop-icon.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:run": "electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64 --dir",
    "dist:win": "npm run desktop:build && electron-builder --win nsis --x64",
    "test:desktop": "node --test tests/desktop-data.test.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "3d-force-graph": "^1.80.2",
    "cytoscape": "^3.33.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.4",
    "playwright": "1.64.1",
    "prettier": "3.5.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "description": "Local organizational knowledge desktop with Ollama, RAG and an interactive knowledge graph",
  "author": "DemoTech",
  "main": "electron/main.mjs"
}
